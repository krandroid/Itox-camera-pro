<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <TextureView
        android:id="@+id/textureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Subtle Vignette Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#40000000" />

    <!-- Top UI Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_circle_glass_dark"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@drawable/bg_rec_dot"
                android:layout_marginEnd="8dp"/>
                
            <TextView
                android:id="@+id/tvRecTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REC 00:00:00"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:letterSpacing="0.05" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_glass_dark"
            android:src="@drawable/ic_settings"
            android:padding="10dp"
            android:scaleType="centerInside"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- Bottom Controls Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingBottom="40dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Mode Selector -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PHOTO"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#66FFFFFF"
                android:letterSpacing="0.1"
                android:layout_marginEnd="32dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VIDEO"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:letterSpacing="0.1" />
                <View
                    android:layout_width="4dp"
                    android:layout_height="4dp"
                    android:background="@drawable/bg_rec_dot"
                    android:layout_marginTop="4dp"
                    android:backgroundTint="#FFFFFF"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DUAL"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#66FFFFFF"
                android:letterSpacing="0.1"
                android:layout_marginStart="32dp"/>
        </LinearLayout>

        <!-- Main Action Bar (Frosted Glass) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/controlPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1AFFFFFF"
            app:strokeColor="#33FFFFFF"
            app:strokeWidth="1dp"
            app:cardCornerRadius="40dp"
            app:cardElevation="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:paddingVertical="16dp"
                android:clipToPadding="false">

                <!-- Gallery Button -->
                <ImageButton
                    android:id="@+id/btnGallery"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_gallery_btn"
                    android:src="@drawable/ic_gallery"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    app:tint="@android:color/white" />

                <!-- Capture Button -->
                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginHorizontal="32dp">

                    <View
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/bg_capture_ring" />
                        
                    <ImageButton
                        android:id="@+id/btnCapture"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_capture_inner"
                        android:src="@drawable/ic_camera"
                        android:padding="16dp"
                        android:scaleType="centerInside"
                        app:tint="@android:color/white" />
                </FrameLayout>

                <!-- Switch Mode Button -->
                <ImageButton
                    android:id="@+id/btnSwitchMode"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circle_glass"
                    android:src="@drawable/ic_video"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    app:tint="@android:color/white" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Zoom Control Pill -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.5x"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#99FFFFFF"
                android:letterSpacing="0.1"
                android:layout_marginEnd="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1x"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_circle_glass"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp"
                android:letterSpacing="0.1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2.0x"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#99FFFFFF"
                android:letterSpacing="0.1"
                android:layout_marginStart="16dp"/>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
